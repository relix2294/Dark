# Без домена: SITE_ADDRESS=:80 и сайт по http://IP:HTTP_PORT. С доменом: SITE_ADDRESS=dark.example.tj, HTTP_PORT=80, HTTPS_PORT=443.
SITE_ADDRESS=:80
HTTP_PORT=8090
HTTPS_PORT=8453
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-openssl-rand-hex-32
