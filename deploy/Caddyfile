# SITE_ADDRESS: домен (dark.example.tj) — автоматический HTTPS (нужны свободные 80/443);
# :80 — без домена, по IP и порту HTTP_PORT. /api и /docs → api, /media — фото, остальное — фронты из deploy/www/<app>.
{$SITE_ADDRESS} {
	encode zstd gzip

	# базовые заголовки безопасности для всех ответов
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options SAMEORIGIN
		Permissions-Policy "geolocation=(self), camera=(self), microphone=()"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}
	handle /docs* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}

	# фото товаров с тома (STORAGE_DRIVER=local); имена файлов — хэш содержимого, кэш навсегда
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Фронты: /store (витрина), /office (админка + пульт), /kds (кухня), /picker (терминал). SPA fallback.
	@spa path /store/* /office/* /kds/* /picker/*
	handle @spa {
		root * /srv/www
		try_files {path} {path}/ /{http.request.uri.path.0}/index.html
		file_server
	}
	handle {
		root * /srv/www
		file_server
	}
}
