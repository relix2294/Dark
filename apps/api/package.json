{
  "name": "@dark/api",
  "version": "0.1.0",
  "private": true,
  "description": "Модульный монолит: core-api, payments, wms, kds, dispatch, backoffice, notify",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node ../../scripts/check-boundaries.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/shared/db/migrate.ts",
    "db:seed": "tsx src/shared/db/seed.ts"
  },
  "dependencies": {
    "@dark/contracts": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@fastify/websocket": "^11.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.16.0",
    "pg-boss": "^10.3.0",
    "pino": "^9.7.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
