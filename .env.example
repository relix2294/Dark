# Скопируйте в .env (локально) или в deploy/.env (на сервере)
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://dark:dark@127.0.0.1:5432/dark
TEST_DATABASE_URL=postgres://dark:dark@127.0.0.1:5432/dark_test
# Секрет подписи JWT персонала и клиентов. Сгенерировать: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
# Адаптер кошелька DC: stub пока нет контракта банка
PAYMENT_PROVIDER=stub
# Часовой пояс отображения (хранение всегда UTC)
DISPLAY_TZ=Asia/Dushanbe
